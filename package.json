{
  "name": "@inzumer/prettier",
  "version": "1.0.0",
  "description": "Shared Prettier configuration for Inzumer projects (import order included)",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/inzumer-prettier#readme",
  "bugs": {
    "url": "https://github.com/inzumer/inzumer-prettier/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/inzumer-prettier.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "main": "index.json",
  "exports": {
    ".": "./index.json"
  },
  "files": [
    "index.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1"
  },
  "scripts": {
    "check": "prettier --config index.json --check .",
    "format": "prettier --config index.json --write .",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.9.9"
  }
}
